# PostgreSQL connection string
# Format: postgresql://[user[:password]@][host[:port]][/dbname][?options]
# For Layerbase: use pooled connection string with sslmode=require
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# Optional: Delay between requests (default: 1.0 seconds)
# DELAY=1.0

# Optional: Maximum pages per run (default: 50)
# MAX_PAGES=50

# Optional: Maximum link depth (default: 2)
# MAX_DEPTH=2
